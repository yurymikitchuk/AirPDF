<Window x:Class="AirPDF.ExportOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Экспорт в Microsoft Word"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgPanel}"
        FontFamily="Segoe UI, Consolas"
        ShowInTaskbar="False">
    <Border Padding="16" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0">
        <StackPanel>
            <TextBlock Text="Экспорт в Microsoft Word"
                       Style="{StaticResource DialogTitle}"/>
            <TextBlock x:Name="InfoText"
                       Margin="0,6,0,12"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMuted}"/>

            <TextBlock Text="Режим"
                       FontSize="12"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="0,0,0,4"/>
            <ComboBox x:Name="ModeCombo"
                      Style="{StaticResource CursorComboBox}"
                      Margin="0,0,0,12"/>

            <RadioButton x:Name="AllPagesRadio"
                         Content="Все страницы"
                         IsChecked="True"
                         Margin="0,0,0,8"
                         Foreground="{DynamicResource TextPrimary}"
                         Checked="Mode_Changed"/>
            <RadioButton x:Name="CurrentPageRadio"
                         Content="Текущая страница"
                         Margin="0,0,0,8"
                         Foreground="{DynamicResource TextPrimary}"
                         Checked="Mode_Changed"/>
            <RadioButton x:Name="RangeRadio"
                         Content="Диапазон / список"
                         Margin="0,0,0,8"
                         Foreground="{DynamicResource TextPrimary}"
                         Checked="Mode_Changed"/>

            <TextBox x:Name="RangeBox"
                     Style="{StaticResource FormTextBox}"
                     Margin="22,0,0,4"
                     IsEnabled="False"/>
            <TextBlock Width="240"
                       HorizontalAlignment="Left"
                       Text="Например: 1-3, 5, 8-10"
                       Margin="22,0,0,12"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMuted}"/>

            <TextBlock Text="Путь к файлу"
                       FontSize="12"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="0,0,0,4"/>
            <Grid Height="30" Margin="0,0,0,14">
                <TextBox x:Name="PathBox"
                         Style="{StaticResource CursorTextBox}"
                         Height="30"
                         MinHeight="30"
                         Padding="8,0,32,0"
                         IsReadOnly="False"
                         AcceptsReturn="False"
                         TextWrapping="NoWrap"
                         TextAlignment="Left"
                         HorizontalContentAlignment="Left"
                         VerticalContentAlignment="Center"
                         Cursor="IBeam"/>
                <Button HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Width="28"
                        Height="24"
                        Margin="0,0,3,0"
                        Panel.ZIndex="1"
                        Focusable="False"
                        ToolTip="Обзор…"
                        Click="Browse_Click"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    CornerRadius="3"
                                    Padding="4,2">
                                <TextBlock Text="&#xE8B7;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextMuted}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHover}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgApp}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <TextBlock x:Name="ErrorText"
                       Foreground="{DynamicResource Danger}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,10"
                       Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Style="{StaticResource DialogButton}"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click"/>
                <Button Content="Экспорт"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
