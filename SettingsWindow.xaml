<Window x:Class="AirPDF.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgPanel}"
        FontFamily="Segoe UI, Consolas"
        ShowInTaskbar="False">
    <Border Padding="16" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0">
        <StackPanel>
            <TextBlock Text="Настройки"
                       Style="{StaticResource DialogTitle}"/>
            <TextBlock Text="Параметры интерфейса AirPDF."
                       Margin="0,6,0,12"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMuted}"/>

            <TextBlock Text="Тема"
                       FontSize="12"
                       Foreground="{DynamicResource TextMuted}"
                       Margin="0,0,0,8"/>

            <StackPanel Margin="0,0,0,14">
                <RadioButton x:Name="LightThemeRadio"
                             Content="Светлая"
                             GroupName="Theme"
                             Margin="0,0,0,8"
                             Foreground="{DynamicResource TextPrimary}"
                             Checked="Theme_Changed"/>
                <RadioButton x:Name="DarkThemeRadio"
                             Content="Тёмная"
                             GroupName="Theme"
                             Foreground="{DynamicResource TextPrimary}"
                             Checked="Theme_Changed"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена"
                        Style="{StaticResource DialogButton}"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click"/>
                <Button Content="OK"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Click="Ok_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
