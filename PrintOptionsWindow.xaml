<Window x:Class="AirPDF.PrintOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Печать"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="820"
        Height="560"
        MinWidth="760"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{DynamicResource BgPanel}"
        FontFamily="Segoe UI, Consolas"
        ShowInTaskbar="False"
        Closed="Window_Closed">
    <Border BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="0,1,0,0">
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Column="0"
                          Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Печать"
                               Style="{StaticResource DialogTitle}"/>
                    <TextBlock x:Name="InfoText"
                               Margin="0,6,0,12"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMuted}"/>

                    <TextBlock Text="Принтер"
                               FontSize="12"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="0,0,0,4"/>
                    <ComboBox x:Name="PrinterCombo"
                              Style="{StaticResource CursorComboBox}"
                              Margin="0,0,0,12"
                              DisplayMemberPath="FullName"/>

                    <TextBlock Text="Ориентация"
                               FontSize="12"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="0,0,0,4"/>
                    <ComboBox x:Name="OrientationCombo"
                              Style="{StaticResource CursorComboBox}"
                              Margin="0,0,0,12"
                              SelectionChanged="PrintOption_Changed"/>

                    <TextBlock Text="Масштаб"
                               FontSize="12"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="0,0,0,4"/>
                    <ComboBox x:Name="ScaleCombo"
                              Style="{StaticResource CursorComboBox}"
                              Margin="0,0,0,14"
                              SelectionChanged="PrintOption_Changed"/>

                    <RadioButton x:Name="AllPagesRadio"
                                 Content="Все страницы"
                                 IsChecked="True"
                                 Margin="0,0,0,8"
                                 Foreground="{DynamicResource TextPrimary}"
                                 Checked="Mode_Changed"/>
                    <RadioButton x:Name="CurrentPageRadio"
                                 Content="Текущая страница"
                                 Margin="0,0,0,8"
                                 Foreground="{DynamicResource TextPrimary}"
                                 Checked="Mode_Changed"/>
                    <RadioButton x:Name="RangeRadio"
                                 Content="Диапазон / список"
                                 Margin="0,0,0,8"
                                 Foreground="{DynamicResource TextPrimary}"
                                 Checked="Mode_Changed"/>

                    <TextBox x:Name="RangeBox"
                             Style="{StaticResource FormTextBox}"
                             Margin="22,0,0,4"
                             IsEnabled="False"
                             TextChanged="RangeBox_TextChanged"/>
                    <TextBlock Width="240"
                               HorizontalAlignment="Left"
                               Text="Например: 1-3, 5, 8-10"
                               Margin="22,0,0,10"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMuted}"/>

                    <TextBlock x:Name="ErrorText"
                               Foreground="{DynamicResource Danger}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="PreviewStatusText"
                               FontSize="12"
                               Foreground="{DynamicResource TextMuted}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2"
                    Grid.Row="0"
                    Background="{DynamicResource BgApp}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Предпросмотр"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBright}"
                               Margin="0,0,0,8"/>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="PreviewPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <StackPanel Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Grid.Row="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,14,0,0">
                <Button Content="Отмена"
                        Style="{StaticResource DialogButton}"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="Cancel_Click"/>
                <Button Content="Печать"
                        Style="{StaticResource PrimaryButton}"
                        IsDefault="True"
                        Click="Print_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
